#!/usr/bin/env bash
set -euo pipefail

MANIFEST="$(git rev-parse --show-toplevel)/Cargo.toml"

say()  { printf '\033[1;34m▸ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1" >&2; exit 1; }

say "pre-commit: rustfmt"
cargo fmt --manifest-path "$MANIFEST" --check \
    || fail 'Código sin formatear. Arreglalo con: cargo fmt'

say "pre-commit: clippy"
cargo clippy --manifest-path "$MANIFEST" --all-targets -- -D warnings \
    || fail 'Clippy encontró problemas. Probá: cargo clippy --fix --allow-staged --allow-dirty
         Lo que no se arregle solo, corregilo a mano. Bypass de emergencia: git commit --no-verify'

say "pre-commit: OK"
