. "$HOME/.cargo/env"

# Claude Code sin memoria propia ni conectores de claude.ai: Engram es la
# única memoria y los MCP salen de claude/mcp.json.
# settings.json no aplica dentro de Pi (settingSources: []), así que estas
# variables son el único interruptor que cubre la terminal y Pi.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
