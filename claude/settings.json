{
  "syncClaudeAiPlugins": false,
  "permissions": {
    "allow": [
      "Bash(bat *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(sd *)",
      "Bash(eza *)",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "mcp__engram__*",
      "mcp__context7__*"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-bash.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{tool_input: {command: (\"cat \" + (.tool_input.file_path // \"\"))}}' | bash \"$HOME/.claude/hooks/guard-bash.sh\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-pi.sh"
  },
  "extraKnownMarketplaces": {
    "locus": {
      "source": {
        "source": "directory",
        "path": "/home/m4s1t4/Documents/Obsidian/roam/programación/ia/skills/skill-stack"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "custom:omarchy",
  "autoCompactEnabled": true,
  "terminalProgressBarEnabled": true,
  "enabledPlugins": {
    "locus@locus": true
  }
}
