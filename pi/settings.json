{
  "defaultModel": "lfm3-1.7b",
  "defaultProvider": "llama.cpp",
  "lastChangelogVersion": "1.1.0",
  "npmCommand": [
    "mise",
    "exec",
    "node@24.21.0",
    "--",
    "npm"
  ],
  "packages": [
    "npm:gentle-engram@0.1.16",
    "npm:@upstash/context7-pi@0.1.2",
    "../../Work/pp/ccp/pi-markdown-rendering",
    "../../Work/pp/ccp/pi-codesanbox-execution",
    "../../Work/pp/ccp/pi-statusline",
    "npm:pi-web-access@0.46.0"
  ],
  "theme": "omarchy-system",
  "compaction": {
    "enabled": true
  },
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
