    "!redesign-existing-projects",
    "!stitch-design-taste",
    "!emil-design-eng",
    "!image-to-code",
    "!imagegen-frontend-mobile",
    "!imagegen-frontend-web",
    "!brandkit",
    "!frontend-slides",
    "!anatomy",
    "!fframes-video",
    "!remotion-best-practices",
    "!find-skills",
    "!skill-doctor",
    "!build-egui-apps",
    "!build-gpui-apps",
    "!diagnose-crash",
    "!hf-cli"
  ]
