// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "space w t": "terminal_panel::ToggleFocus",
      "space w o": "project_panel::ToggleFocus",
    },
  },
  {
    // I had to add this here because it seems like setting them to null doesn't
    // really does anything. Duplicating the workspace panel focus works.
    "context": "(VimControl || (!Editor && !Terminal))",
    "use_key_equivalents": true,
    "bindings": {
      "space w t": "terminal_panel::ToggleFocus",
      "space w p": "agent::ToggleFocus",
      "space w o": "project_panel::ToggleFocus",
      "space p q": "workspace::CloseProject",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-x ctrl-o": "editor::ShowWordCompletions",
      "ctrl-x ctrl-a": "assistant::InlineAssist",
      "ctrl-x ctrl-c": "editor::ShowEditPrediction",
      // "j k": "vim::NormalBefore"
      "j j": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      // "j k": "vim::NormalBefore"
      "j j": "vim::NormalBefore",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "s h": "workspace::ActivatePaneLeft",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g s": "outline::Toggle",
      "g i": "editor::ToggleCodeActions",
      "g d": "editor::OpenExcerpts",
      "g b": "pane::GoToOlderTag",
      "g c": ["editor::ToggleComments", { "advance_downwards": false }],
    },
  },
  {
    "context": "Editor && VimControl && !VimWiting && !menu",
    "bindings": {
      "g l": "vim::SelectNext",
      "g L": "vim::SelectPrevious",
      "g a": "editor::SelectAllMatches",
      "g shift-a": "editor::FindAllReferences",
      "g f": "project_symbols::Toggle",
      "space p e": "diagnostics::Deploy",
      "space z": "workspace::ToggleZoom", // Zed specific
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Markdown
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      // Git
      "space g h d": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // TODO: Maybe check for another keybinding and other ways to do this.
      // FIXME: Right now the active pane is also split to the right due to async nature
      // (related to https://github.com/zed-industries/zed/issues/42555).
      // "space t v": [
      //   "action::Sequence",
      //   ["workspace::NewCenterTerminal", "pane::SplitRight"],
      // ],
      "space t h": [
        "action::Sequence",
        ["workspace::NewCenterTerminal", "pane::SplitRight"],
      ],

      // Key-bindings to work only in normal mode
      "space e": "editor::Hover",

      // Window Creation
      "s v": "pane::SplitRight",
      "s s": "pane::SplitDown",
      // Window Navigation
      "s l": "workspace::ActivatePaneRight",
      "s h": "workspace::ActivatePaneLeft",
      "s k": "workspace::ActivatePaneUp",
      "s j": "workspace::ActivatePaneDown",
      // Buffer Navigation
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      // Finders & Formats
      "space p f": "file_finder::Toggle",
      "space p r": "pane::DeploySearch",
      "space p t": "tab_switcher::Toggle",
      "space f": "editor::Format",

      "space w l": "workspace::ToggleRightDock",
      "space w h": "workspace::ToggleLeftDock",
      "space w j": "workspace::ToggleBottomDock",
      "space w t": "pane::TogglePinTab",

      // Error navigation
      "[ e": "editor::GoToDiagnostic",
      "] e": "editor::GoToPreviousDiagnostic",

      // Git
      "[ g": "editor::GoToHunk",
      "] g": "editor::GoToPreviousHunk",

      // YouTube Usage
      // "k": ["workspace::SendKeystrokes", "up z z"],
      // "j": ["workspace::SendKeystrokes", "down z z"],
    },
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      // Key-bindings for being in terminal
      "space w i": "terminal_panel::ToggleFocus",
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Key-bindings for empty pane
      "space p f": "file_finder::Toggle",
      "space p r": "projects::OpenRecent",
      "ctrl-w l": "workspace::ToggleRightDock",
    },
  },
]
