# Colors follow the active Omarchy theme: Omarchy renders omarchy-theme.tpl
# into this file on every theme change.
include ../../.local/state/omarchy/current/theme/zathura

# Reading
set recolor                     true
set recolor-keephue             true
set render-loading              true
set adjust-open                 width
set scroll-page-aware           true
set scroll-full-overlap         0.15
set scroll-step                 60
set zoom-min                    20
set zoom-max                    500
set zoom-step                   10
set selection-clipboard         clipboard

# Statusbar only: the inputbar appears on demand with ':'
set guioptions                  "s"
set font                        "FiraCode Nerd Font 11"
set window-title-basename       true
set statusbar-basename          true
set statusbar-page-percent      true
set statusbar-h-padding         10
set statusbar-v-padding         6
set show-hidden                 false

# n/N flip pages; t/T move between search matches
map n navigate next
map N navigate previous
map t search next
map T search previous

map d scroll half-down
map u scroll half-up
map f toggle_fullscreen
map i toggle_index
